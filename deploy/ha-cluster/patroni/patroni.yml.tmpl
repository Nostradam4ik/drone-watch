# Шаблон Patroni (підстановка змінних робить entrypoint.sh). Лише TLS: etcd із взаємною автентифікацією сертифікатами, REST API
# Patroni вимагає клієнтський сертифікат, pg_hba без відкритих (не TLS) і без безпарольних правил, паролі scram-sha-256.
scope: ${CLUSTER_SCOPE}
name: ${NODE_NAME}

restapi:
  listen: 0.0.0.0:8008
  connect_address: ${NODE_IP}:8008
  certfile: /tmp/tls/pg.crt
  keyfile: /tmp/tls/pg.key
  cafile: /tmp/tls/ca.crt
  verify_client: required

etcd3:
  hosts: ${A_IP}:2379,${B_IP}:2379,${W_IP}:2379
  protocol: https
  cacert: /tmp/tls/ca.crt
  cert: /tmp/tls/etcd.crt
  key: /tmp/tls/etcd.key

bootstrap:
  dcs:
    ttl: 20
    loop_wait: 5
    retry_timeout: 5
    maximum_lag_on_failover: 1048576
    # Синхронна реплікація БЕЗ strict (рішення користувача): при смерті репліки master пише далі (можлива втрата кількох останніх
    # записів, якщо потім помре й master); strict зупинив би запис, поки репліки нема.
    synchronous_mode: true
    synchronous_mode_strict: false
    postgresql:
      use_pg_rewind: true
      parameters:
        ssl: 'on'
        ssl_cert_file: /tmp/tls/pg.crt
        ssl_key_file: /tmp/tls/pg.key
        ssl_min_protocol_version: TLSv1.2
        password_encryption: scram-sha-256
        wal_level: replica
        hot_standby: 'on'
        wal_log_hints: 'on'
        max_wal_senders: 10
        max_replication_slots: 10
  initdb:
    - encoding: UTF8
    - data-checksums
  # Порядок важливий (перше збіжне правило). Реплікація й суперкористувач лише з адрес вузлів даних. dw_app і dw_owner
  # приймаються з будь-якої адреси: порт опублікований лише на адресі WireGuard вузла, а вхід усе одно через TLS і пароль.
  pg_hba:
    - local all all peer
    - hostssl replication replicator ${A_IP}/32 scram-sha-256
    - hostssl replication replicator ${B_IP}/32 scram-sha-256
    - hostssl all postgres ${A_IP}/32 scram-sha-256
    - hostssl all postgres ${B_IP}/32 scram-sha-256
    - hostssl dronewatch dw_app 0.0.0.0/0 scram-sha-256
    - hostssl dronewatch dw_owner 0.0.0.0/0 scram-sha-256
  post_bootstrap: /opt/dw/post_bootstrap.sh

postgresql:
  listen: 0.0.0.0:5432
  connect_address: ${NODE_IP}:5432
  data_dir: /var/lib/postgresql/data/pgdata
  pgpass: /tmp/pgpass
  authentication:
    superuser:
      username: postgres
      password: ${PG_SUPERUSER_PASSWORD}
    replication:
      username: replicator
      password: ${PG_REPLICATION_PASSWORD}
  parameters:
    unix_socket_directories: /var/run/postgresql

tags:
  nofailover: false
  noloadbalance: false
  clonefrom: false
  nosync: false
