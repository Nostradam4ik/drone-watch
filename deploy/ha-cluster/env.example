# Змінні кластера. Скопіюйте в `.env` НА КОЖНІЙ МАШИНІ, заповніть і виставте chmod 600. `.env` у .gitignore: не комітьте його.
# Паролі лише з символів A-Za-z0-9_.- (вони йдуть у конфіги без лапок). Довгі випадкові: openssl rand -hex 24
# Спільні для всіх трьох машин: адреси WireGuard і паролі однакові.
CLUSTER_SCOPE=dronewatch
A_IP=10.10.0.1
B_IP=10.10.0.2
W_IP=10.10.0.3

# Різне на кожній машині: node-a | node-b | witness і адреса WireGuard цієї машини (A_IP, B_IP чи W_IP).
NODE_NAME=node-a
NODE_IP=10.10.0.1
# Публічна адреса цієї машини для датчиків (MQTT 8883) і дашборда (HTTPS 8000). Не 0.0.0.0.
PUBLIC_BIND=203.0.113.10
# Каталог із сертифікатами цієї машини (копія certs/node-a чи certs/node-b чи certs/witness).
CERTS_DIR=./certs

PG_SUPERUSER_PASSWORD=CHANGE_ME
PG_REPLICATION_PASSWORD=CHANGE_ME
DW_OWNER_PASSWORD=CHANGE_ME
DW_APP_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
REDIS_MASTER_NAME=dw
# Лише на node-b: адреса початкового master Redis (A_IP). На node-a і witness порожньо.
REDIS_REPLICAOF=

# Логін копії сервісу в ЇЇ брокері (власний на копію, див. README): node-a dronewatch-service, node-b dronewatch-service-2.
MQTT_USER=dronewatch-service
MQTT_PASSWORD=CHANGE_ME
